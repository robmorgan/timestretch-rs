@@ -38,6 +38,8 @@
 const ADAPTIVE_FORCE_ROI_RATIO_DISTANCE: f64 = 0.75;
 /// Number of synthesis frames to keep transient-focused locking active.
 const TRANSIENT_FOCUS_FRAMES: usize = 3;
+/// Number of synthesis frames to tighten phase locking after a ratio update.
+const RATIO_TRANSITION_FOCUS_FRAMES: usize = 2;
 /// Small cross-unity modulation band where carried overlap normalization can
 /// safely re-anchor to unity instead of inheriting the previous expansion.
 const STREAMING_TAIL_UNITY_NEUTRAL_DISTANCE: f64 = 0.05;
@@ -366,8 +368,17 @@
     /// real-time ratio changes that avoid clicks and discontinuities.
     #[inline]
     pub fn set_stretch_ratio(&mut self, stretch_ratio: f64) {
+        let ratio_changed = (stretch_ratio - self.stretch_ratio).abs() > SYNTH_POS_EPSILON;
         self.stretch_ratio = stretch_ratio;
         self.hop_synthesis = (self.hop_analysis as f64 * stretch_ratio).round() as usize;
+        if ratio_changed {
+            // Hold a short identity-locking window across ratio transitions so
+            // the first overlap region after a step stays phase-coherent
+            // without reseeding or resetting steady-state history.
+            self.transient_focus_frames = self
+                .transient_focus_frames
+                .max(RATIO_TRANSITION_FOCUS_FRAMES);
+        }
     }
 
     /// Resets the phase accumulator and previous-phase buffers.
@@ -2205,6 +2216,46 @@
     }
 
     #[test]
+    fn test_set_stretch_ratio_engages_short_transition_focus_without_resetting_phase() {
+        let mut pv = PhaseVocoder::new(1024, 256, 1.0, 44_100, 120.0);
+        pv.phase_accum.fill(0.75);
+        pv.prev_phase.fill(0.5);
+        pv.phase_seed_pending.fill(false);
+
+        pv.set_stretch_ratio(1.03);
+
+        assert_eq!(
+            pv.transient_focus_frames, RATIO_TRANSITION_FOCUS_FRAMES,
+            "ratio transition should engage a short stabilization window"
+        );
+        assert!(
+            pv.phase_accum.iter().all(|&phase| (phase - 0.75).abs() < 1e-12),
+            "ratio transition must preserve accumulated phase state"
+        );
+        assert!(
+            pv.prev_phase.iter().all(|&phase| (phase - 0.5).abs() < 1e-12),
+            "ratio transition must preserve previous analysis phases"
+        );
+        assert!(
+            pv.phase_seed_pending.iter().all(|&pending| !pending),
+            "ratio transition should not force reseeding"
+        );
+    }
+
+    #[test]
+    fn test_set_stretch_ratio_same_ratio_does_not_engage_transition_focus() {
+        let mut pv = PhaseVocoder::new(1024, 256, 1.0, 44_100, 120.0);
+        assert_eq!(pv.transient_focus_frames, 0);
+
+        pv.set_stretch_ratio(1.0);
+
+        assert_eq!(
+            pv.transient_focus_frames, 0,
+            "unchanged ratio should not trigger transition focus"
+        );
+    }
+
+    #[test]
     fn test_process_streaming_and_flush_produce_finite_output() {
         let fft_size = 2048;
