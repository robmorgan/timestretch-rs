+            LatencyProfile::Scratch,
+            "re-arming from scratch should cancel the stale mix retarget"
+        );
+        assert_eq!(
+            rearmed.policy_profile,
+            LatencyProfile::Scratch,
+            "policy telemetry should reflect the renewed scratch hold"
+        );
+        assert_eq!(
