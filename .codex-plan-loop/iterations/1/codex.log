+    .collect();
+    let window = (sample_rate as f64 * 0.008).round() as usize; // +/-8ms
+    let guard = (sample_rate as f64 * 0.001).round() as usize; // +/-1ms
+    let baseline_stats =
+        boundary_artifact_stats(&baseline_left, &baseline_positions, window, guard);
